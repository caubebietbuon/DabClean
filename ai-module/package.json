{
  "name": "dabclean-ai-module",
  "version": "2.0.0",
  "private": true,
  "description": "Module AI: quét ảnh độ bẩn bằng MobileNet transfer learning (TensorFlow.js) + gợi ý giá dịch vụ",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "train": "node train.js",
    "predict": "node predict.js",
    "evaluate": "node test/evaluate.js",
    "check-formats": "node test/check-formats.js",
    "test": "node --test test/v3/*.test.js",
    "prepare:v3": "node scripts/prepare-v3.js",
    "benchmark:v3": "node scripts/benchmark-v3.js",
    "benchmark:v31": "node scripts/benchmark-v31.js",
    "smoke:v31": "node scripts/smoke-v31.js",
    "capture:v31": "node scripts/capture-v31.js",
    "calibrate:v31": "node scripts/calibrate-v31.js",
    "ollama:local": "node scripts/serve-ollama-local.js"
  },
  "keywords": [
    "dabclean",
    "ai",
    "tensorflow",
    "mobilenet",
    "transfer-learning",
    "image-classification",
    "express"
  ],
  "author": "DabClean Team",
  "license": "ISC",
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jpeg-js": "^0.4.4",
    "multer": "^2.4.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "linkedom": "0.18.14"
  },
  "engines": {
    "node": ">=22"
  }
}

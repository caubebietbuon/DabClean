# ============================================================
# DABCLEAN AI MODULE - Mẫu biến môi trường
# ============================================================
# HƯỚNG DẪN: copy file này thành `.env` rồi chỉnh theo máy của bạn.
#   Windows : copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# File `.env` sẽ KHÔNG được đẩy lên git (đã có trong .gitignore)
# để tránh lộ cấu hình / API key.
# ============================================================

# Cổng chạy module AI (tách biệt với backend chính ở cổng 5000)
PORT=5100

# HOST=0.0.0.0 cho phép máy khác trong cùng WiFi/LAN truy cập
HOST=0.0.0.0

# ------------------------------------------------------------
# Công nghệ AI
# Module dùng TensorFlow.js (bản thuần JavaScript) + MobileNet
# huấn luyện sẵn, kết hợp transfer learning 2 lớp Dense tự train.
# Không cần GPU, không cần tfjs-node, không cần API key.
# ------------------------------------------------------------

# Giới hạn dung lượng ảnh tải lên (bytes). Mặc định 10MB
MAX_UPLOAD_BYTES=10485760

# AI V3: experimental local image understanding; legacy V2 endpoints remain available.
# For integrated backend, put these keys in backend/.env instead.
AI_V3_ENABLED=true
AI_V3_PROVIDER=clip
# Download model artifacts once with npm run prepare:v3, then disable outbound model downloads.
AI_V3_OFFLINE=false
# Optional absolute cache location; default ai-module/.cache/v3 (gitignored).
# AI_V3_CACHE_DIR=D:/models/dabclean-v3
# Alternative local vision-language provider; never use a public/remote hostname.
AI_V3_OLLAMA_URL=http://127.0.0.1:11434
AI_V3_OLLAMA_MODEL=qwen3-vl:2b-instruct

# V3.1 keeps /v3 intact and adds /v3.1 with six-factor scoring.
AI_V31_ENABLED=true
AI_V31_PROVIDER=ollama
# Only a version-matched artifact fitted from reviewed, room-disjoint data can unlock numeric scores.
# No artifact is bundled. Never put model guesses in place of human reference labels.
# AI_V31_CALIBRATION_FILE=D:/private/cleanness-calibration-v1.json

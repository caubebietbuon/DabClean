# ============================================================
# CLEANOVA - .gitignore
# ============================================================
# Chỉ chặn file chứa thông tin nhạy cảm (mật khẩu, secret key)
# và thư mục upload tạm. Mọi thứ khác đều được push.
# ============================================================

# Dependencies — KHÔNG commit (nặng ~280MB, cài lại bằng: npm install)
node_modules/

# Dataset ảnh huấn luyện — KHÔNG commit (nặng ~174MB, 1057 ảnh).
# Muốn train lại: đặt ảnh vào ai-module/dataset/{sach,hoi-ban,rat-ban}/
# rồi chạy: node train.js
ai-module/dataset/

# Model thử nghiệm & kết quả test tạm
ai-module/_smoke/
ai-module/_smoke.log
ai-module/_test-model/
ai-module/compare-result.json

# Environment variables (chứa mật khẩu MySQL, JWT secret)
.env
backend/.env
ai-module/.env

# Thư mục upload tạm
backend/uploads/

# Logs
*.log
npm-debug.log*

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS Generated Files
Desktop.ini
ehthumbs.db

# Build output
dist/
build/

# Local AI weights/cache and private benchmark images
ai-module/.cache/
ai-module/benchmark/images/
ai-module/benchmark/private/

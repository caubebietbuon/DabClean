# ============================================================
# CLEANOVA - .gitignore
# ============================================================
# Chỉ chặn file chứa thông tin nhạy cảm (mật khẩu, secret key)
# và thư mục upload tạm. Mọi thứ khác đều được push.
# ============================================================

# Environment variables (chứa mật khẩu MySQL, JWT secret)
.env
backend/.env
ai-module/.env

# Thư mục upload tạm
backend/uploads/

# Logs
*.log
npm-debug.log*

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS Generated Files
Desktop.ini
ehthumbs.db

# Build output
dist/
build/